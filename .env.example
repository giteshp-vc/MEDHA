# MEDHA Configuration

# Primary LLM Provider: 'groq' (default) or 'gemini'
LLM_PROVIDER=groq

# Groq Configuration (Primary)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Google Gemini Configuration (Optional Alternative)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Model Parameters
TEMPERATURE=0.2

# Retry & Rate Limit Configuration
MAX_RETRIES=3
INITIAL_RETRY_DELAY=1.0
MAX_RETRY_DELAY=10.0

# Multi-Agent Execution Configuration
MAX_CONCURRENT_AGENTS=4
MAX_REPAIR_ITERATIONS=2
EXECUTION_TIMEOUT_SECONDS=180.0

# Verification & LLM Budget Configuration
# Maximum claims registered per task; overflow is explicitly reported
MAX_CLAIMS_PER_TASK=50
# Number of claims evaluated in a single LLM audit request
REVIEW_BATCH_SIZE=5
# Maximum revision-requested claims repaired per iteration
MAX_REPAIR_CLAIMS_PER_ITERATION=3
# Central guardrail: maximum LLM calls permitted across an entire task
MAX_LLM_CALLS_PER_TASK=25
# Application-local token budget; this does not reveal the provider account's daily quota
MAX_TOKENS_PER_TASK=50000
# Conservative estimated prompt ceiling per call
MAX_INPUT_TOKENS_PER_CALL=12000
# Maximum completion tokens per individual LLM call
MAX_OUTPUT_TOKENS_PER_CALL=2048
# Protected task-local reserves for essential stages
CLAIM_EXTRACTION_TOKEN_RESERVE=4096
VERIFICATION_TOKEN_RESERVE=12288
SYNTHESIS_TOKEN_RESERVE=4096

# Application & Logging
APP_ENV=development
LOG_LEVEL=INFO
